---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string | false;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  stripMetaClickId?: boolean;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  schema,
  stripMetaClickId = false,
} = Astro.props;

const canonical = canonicalPath === false ? null : new URL(canonicalPath, Astro.site).href;
const image = new URL("/images/george-b-johnson-og.jpg", Astro.site).href;
const robots = noindex
  ? "noindex,follow"
  : "index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1";
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="George B. Johnson" />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#171b18" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/manrope-400-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-400-latin.woff2" as="font" type="font/woff2" crossorigin />

    {stripMetaClickId && (
      <script is:inline>
        (() => {
          const url = new URL(window.location.href);
          const clickId = url.searchParams.get("fbclid");
          if (!clickId) return;
          if (/^[A-Za-z0-9._-]{1,300}$/.test(clickId)) {
            try { sessionStorage.setItem("builders_lab_fbclid", clickId); } catch {}
          }
          url.searchParams.delete("fbclid");
          history.replaceState(null, "", `${url.pathname}${url.search}${url.hash}`);
        })();
      </script>
    )}

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-EK4D73E6DT" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-EK4D73E6DT");
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="George B. Johnson" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="George B. Johnson — technical consultant specializing in AI-driven automation" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content="George B. Johnson — technical consultant specializing in AI-driven automation" />

    {schemas.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/site.js";
    </script>
  </body>
</html>
