---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { BUILDERS_LAB_GA4_PAGE_LOCATION_POLICY } from "../lib/analytics-attribution.js";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string | false;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  schema,
} = Astro.props;

const canonical = canonicalPath === false ? null : new URL(canonicalPath, Astro.site).href;
const image = new URL("/images/george-b-johnson-og.jpg", Astro.site).href;
const robots = noindex
  ? "noindex,follow"
  : "index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1";
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const analyticsAttributionPolicy = Astro.url.pathname === "/builders-lab/"
  ? BUILDERS_LAB_GA4_PAGE_LOCATION_POLICY
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="George B. Johnson" />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#171b18" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/manrope-400-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-400-latin.woff2" as="font" type="font/woff2" crossorigin />

    {analyticsAttributionPolicy && (
      <script src="/scripts/analytics-page-location.js" is:inline></script>
    )}
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-EK4D73E6DT" is:inline></script>
    <script is:inline define:vars={{ analyticsAttributionPolicy }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag("js", new Date());
      const queryFreePageLocation = `${window.location.origin}${window.location.pathname}`;
      const analyticsPageLocation = typeof window.__sanitizeAnalyticsPageLocation === "function"
        ? window.__sanitizeAnalyticsPageLocation(
            window.location.href,
            analyticsAttributionPolicy,
          ) || queryFreePageLocation
        : queryFreePageLocation;
      try { delete window.__sanitizeAnalyticsPageLocation; } catch {}
      let analyticsPageReferrer = "";
      if (document.referrer) {
        try {
          const referrer = new URL(document.referrer);
          analyticsPageReferrer = `${referrer.origin}${referrer.pathname}`;
        } catch {}
      }
      gtag("config", "G-EK4D73E6DT", {
        page_location: analyticsPageLocation,
        page_referrer: analyticsPageReferrer,
      });
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="George B. Johnson" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="George B. Johnson — technical consultant specializing in AI-driven automation" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content="George B. Johnson — technical consultant specializing in AI-driven automation" />

    {schemas.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/site.js";
    </script>
  </body>
</html>
