---
import BaseLayout from "./BaseLayout.astro";
import PageHero from "../components/PageHero.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  eyebrow: string;
  heading: string;
  lead: string;
  currentPage: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  stripMetaClickId?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  eyebrow,
  heading,
  lead,
  currentPage,
  noindex = false,
  schema,
  stripMetaClickId = false,
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site).href;
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: currentPage,
      item: canonical,
    },
  ],
};
const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const schemas = [breadcrumbSchema, ...extraSchemas];
---

<BaseLayout {title} {description} {canonicalPath} {noindex} schema={schemas} {stripMetaClickId}>
  <PageHero {eyebrow} title={heading} {lead} {currentPage} />
  <slot />
</BaseLayout>
